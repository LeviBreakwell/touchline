# Copy this to .env and fill in real values.
# .env is gitignored — never commit it.
# Before deploying, run: source .env

# Docker Hub access token (Account Settings > Security > Access Tokens)
KAMAL_REGISTRY_PASSWORD=

# Postgres password you set when creating the 'touchline' user on the droplet
TOUCHLINE_DATABASE_PASSWORD=

# Resend API key (resend.com > API Keys)
RESEND_API_KEY=
