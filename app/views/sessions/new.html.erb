<% content_for :title, "Sign in – Touchline" %>
<% content_for :suppress_auth_buttons, true %>
<div style="max-width:400px;margin:2rem auto;">
  <h1>Sign in</h1>
  <p style="color:var(--gray-600);margin-bottom:1.5rem;font-size:0.9rem;">Welcome back.</p>

  <%= form_with url: session_path do |f| %>
    <div class="form-group">
      <%= f.label :email_address, "Email" %>
      <%= f.email_field :email_address, autocomplete: "email", autofocus: true, value: params[:email_address] %>
    </div>
    <div class="form-group">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>
    <%= f.submit "Sign in", class: "btn btn-primary btn-full" %>
  <% end %>

  <p style="text-align:center;margin-top:1rem;font-size:0.9rem;color:var(--gray-600);">
    <%= link_to "Forgot password?", new_password_path %> &middot;
    <%= link_to "Create account", new_registration_path %>
  </p>
</div>
