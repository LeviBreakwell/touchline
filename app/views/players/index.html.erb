<% content_for :title, "Roster – #{@team.name}" %>

<%= back_button @team.name, team_path(@team) %>
<div data-controller="dialog" data-dialog-open-value="<%= @player&.errors&.any? || false %>">
<div class="section-header">
  <h1>Roster</h1>
  <%= link_to "Add player", new_team_player_path(@team), class: "btn btn-primary btn-sm",
        data: { action: "dialog#open" } %>
</div>

<% if @players.empty? %>
  <div class="empty">
    <p>No players yet.</p>
    <%= link_to "Add first player", new_team_player_path(@team), class: "btn btn-primary btn-sm",
          data: { action: "dialog#open" } %>
  </div>
<% else %>
  <% @players.each do |player| %>
    <div class="card" style="display:flex;align-items:center;gap:0.5rem;">
      <div style="flex:1;">
        <div style="font-weight:500;">
          <%= link_to player.name, team_player_path(@team, player), class: "leaderboard-player" %>
        </div>
        <% if player.user %>
          <div style="font-size:0.78rem;color:var(--gray-400);">Claimed</div>
        <% elsif player.email.present? %>
          <div style="font-size:0.78rem;color:var(--gray-400);">Links up when <%= player.email %> signs up</div>
        <% end %>
      </div>
      <% unless player.user %>
        <button type="button" class="btn btn-secondary btn-sm" onclick="(function(btn){
          var url = <%= team_invite_url(@team.invite_token, player_id: player.id).to_json %>;
          if (navigator.share) {
            navigator.share({ title: <%= "Join #{@team.name} on Touchline".to_json %>, text: <%= "Join #{@team.name} as #{player.name}".to_json %>, url: url }).catch(function(){});
          } else {
            navigator.clipboard.writeText(url).then(function(){ btn.textContent = 'Copied!'; setTimeout(function(){ btn.textContent = 'Invite' }, 2000) });
          }
        })(this)">Invite</button>
      <% end %>
      <%= link_to "Edit", edit_team_player_path(@team, player), class: "btn btn-secondary btn-sm" %>
      <%= button_to "Remove", team_player_path(@team, player), method: :delete,
            class: "btn btn-secondary btn-sm",
            data: { confirm: "Remove #{player.name}?" } %>
    </div>
  <% end %>
<% end %>

<%= render "players/add_player_dialog", team: @team, player: @player || Player.new %>
</div>
