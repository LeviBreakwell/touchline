<%# team: the Team; player: a Player instance, which may carry validation errors %>
<dialog class="modal" data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop">
  <div class="modal-panel">
    <div class="modal-head">
      <h2>Add player</h2>
      <button type="button" class="modal-close" data-action="dialog#close" aria-label="Close">&times;</button>
    </div>

    <%= form_with model: [ team, player ], url: team_players_path(team) do |f| %>
      <% if player.errors.any? %>
        <div class="flash alert"><%= player.errors.full_messages.first %></div>
      <% end %>

      <div class="form-group">
        <%= f.label :name, "Name" %>
        <%= f.text_field :name, placeholder: "e.g. Damo or Tom H",
              data: { dialog_target: "firstField" } %>
      </div>

      <div class="form-group">
        <%= f.label :email, "Email (optional)" %>
        <%= f.email_field :email, placeholder: "them@example.com", autocomplete: "off" %>
        <p class="field-hint">If they sign up with this address, they'll be linked to this player and added to the team automatically.</p>
      </div>

      <%= f.submit "Add to roster", class: "btn btn-primary btn-full" %>
    <% end %>
  </div>
</dialog>
