<% content_for :title, "#{@player.name} – #{@team.name}" %>

<%= back_button @team.name, team_path(@team) %>

<%# ── IDENTITY ──
    Who they are, in the three things that say it. An unclaimed roster entry
    carries none of it, and the page says so. %>
<% if @progression %>
  <%= render "shared/identity", user: @player.user, progression: @progression, name: @player.name %>
<% else %>
  <div class="tab-head">
    <div class="tab-head-title">
      <h1><%= @player.name %></h1>
      <p class="card-meta">Roster only · no account</p>
    </div>
    <% if Current.user&.admin_of?(@team) %>
      <%= link_to "Edit", edit_team_player_path(@team, @player), class: "btn btn-secondary btn-sm" %>
    <% end %>
  </div>
<% end %>

<% if @progression %>
  <%= render "shared/showcase", progression: @progression %>

  <%# Their progression, same as it reads on their own Profile — just without
      the Customise control, which only ever acts on your own showcase. %>
  <% if @progression.earned.any? %>
    <h2 class="profile-heading">Accolades <span class="count"><%= @progression.earned.size %></span></h2>
    <div class="accolade-list">
      <% @progression.earned.each do |accolade, count| %>
        <div class="accolade-row rarity-<%= accolade.rarity %>">
          <%= accolade_glyph(accolade) %>
          <div style="flex:1;min-width:0;">
            <div class="accolade-name"><%= accolade.title %><%= " ×#{count}" if count > 1 %></div>
            <div class="card-meta"><%= accolade.description %></div>
          </div>
          <div class="accolade-xp">+<%= accolade.xp * count %> XP</div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <p>No accolades yet.</p>
    </div>
  <% end %>

  <% if @progression.left_to_earn.positive? %>
    <h2 class="profile-heading">Still to earn <span class="count"><%= @progression.left_to_earn %></span></h2>
    <%= render "shared/aims", progression: @progression %>
  <% end %>
<% end %>

<%# Your own record lives on your Profile, where it counts every team you play
    for. This page is the Team's view of one name on its roster. %>
<% if @player.user_id == Current.user&.id %>
  <p class="card-meta" style="margin-top:0.5rem;">
    <%= link_to "Your full profile, across every team →", profile_path %>
  </p>
<% end %>

<% unless @career.any? %>
  <div class="empty">
    <p>No games recorded for <%= @player.name %> yet.</p>
  </div>
<% end %>

<% if @career.pending.any? %>
  <%= render "shared/pending_note", pending: @career.pending %>
<% end %>

<% if @career.any? %>
  <%# ── THIS SEASON ──
      Every arrow on the page lives here: the indicator compares this season
      against the rest of the career, because nothing else has data. %>
  <% if @career.season %>
    <h2 class="profile-heading">This season <span class="count"><%= @career.season.name %></span></h2>
    <%= render "shared/season_form", career: @career, name: @player.name %>
  <% end %>

  <h2 class="profile-heading">Career <span class="count"><%= @team.name %></span></h2>
  <%= render "shared/career_totals", line: @career.line %>
  <%= render "shared/career_detail", line: @career.line, mvps: @progression&.count_of("mvp") %>

  <h2 class="profile-heading">By season</h2>
  <%= render "shared/season_table", career: @career %>
<% end %>
