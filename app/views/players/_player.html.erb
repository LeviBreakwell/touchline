<div id="<%= dom_id player %>">
  <p>
    <strong>Name:</strong>
    <%= player.name %>
  </p>

  <p>
    <strong>Jersey number:</strong>
    <%= player.jersey_number %>
  </p>

  <p>
    <strong>Team:</strong>
    <%= player.team_id %>
  </p>

  <p>
    <strong>User:</strong>
    <%= player.user_id %>
  </p>

</div>
