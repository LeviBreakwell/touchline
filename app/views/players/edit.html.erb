<% content_for :title, "Edit #{@player.name} – #{@team.name}" %>

<% if Current.user&.admin_of?(@team) %>
  <%= back_button "Roster", team_players_path(@team) %>
<% else %>
  <%= back_button @team.name, team_path(@team) %>
<% end %>
<h1>Edit player name</h1>

<div style="max-width:400px;margin-top:1rem;">
  <%= form_with model: [@team, @player] do |f| %>
    <% if @player.errors.any? %>
      <div class="flash alert"><%= @player.errors.full_messages.first %></div>
    <% end %>
    <div class="form-group">
      <%= f.label :name, "Name" %>
      <%= f.text_field :name, autofocus: true %>
    </div>
    <%= f.submit "Save", class: "btn btn-primary btn-full" %>
  <% end %>
</div>
