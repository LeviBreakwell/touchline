<div id="<%= dom_id stat %>">
  <p>
    <strong>Stat type:</strong>
    <%= stat.stat_type %>
  </p>

  <p>
    <strong>Value:</strong>
    <%= stat.value %>
  </p>

  <p>
    <strong>Game time:</strong>
    <%= stat.game_time %>
  </p>

  <p>
    <strong>Player:</strong>
    <%= stat.player_id %>
  </p>

  <p>
    <strong>Fixture:</strong>
    <%= stat.fixture_id %>
  </p>

</div>
