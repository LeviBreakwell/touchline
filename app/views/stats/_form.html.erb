<%= form_with(model: stat) do |form| %>
  <% if stat.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(stat.errors.count, "error") %> prohibited this stat from being saved:</h2>

      <ul>
        <% stat.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :stat_type, style: "display: block" %>
    <%= form.number_field :stat_type %>
  </div>

  <div>
    <%= form.label :value, style: "display: block" %>
    <%= form.number_field :value %>
  </div>

  <div>
    <%= form.label :game_time, style: "display: block" %>
    <%= form.number_field :game_time %>
  </div>

  <div>
    <%= form.label :player_id, style: "display: block" %>
    <%= form.text_field :player_id %>
  </div>

  <div>
    <%= form.label :fixture_id, style: "display: block" %>
    <%= form.text_field :fixture_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
