<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Touchline" %></title>
    <%# viewport-fit=cover is what makes env(safe-area-inset-*) mean anything.
        Without it every inset in the stylesheet resolves to 0, so the tab bar
        sits flush on the bottom edge — the strip iOS Safari keeps for its own
        controls, where a tap expands the browser chrome instead of hitting the
        tab it landed on. %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% unless content_for?(:suppress_header) %>
    <header class="site-header">
      <div class="header-inner">

        <div class="header-left">
        </div>

        <% _home_path = if Current.user
             _teams = Current.user.teams.limit(2).to_a
             _teams.size == 1 ? team_path(_teams.first) : root_path
           else
             root_path
           end %>
        <div class="header-center">
          <%= link_to "Touchline", _home_path, class: "brand" %>
        </div>

        <div class="header-right">
          <% if Current.user %>
            <details class="user-menu">
              <summary class="user-avatar" title="<%= Current.user.name %>">
                <%= Current.user.name.split.map(&:first).join.upcase.first(2) %>
              </summary>
              <div class="user-dropdown">
                <div class="user-dropdown-name"><%= Current.user.name %></div>
                <div class="user-dropdown-email"><%= Current.user.email_address %></div>
                <div class="nav-dropdown-divider" style="margin-top:0.4rem;"></div>
                <%= link_to "My Profile", profile_path, class: "nav-dropdown-link" %>
                <%= link_to "My Teams", _home_path, class: "nav-dropdown-link" %>
                <%= link_to "Find a team on TRL", trl_locations_path, class: "nav-dropdown-link" %>
                <div class="nav-dropdown-divider"></div>
                <%= button_to "Sign out", session_path, method: :delete, class: "nav-dropdown-link nav-dropdown-signout" %>
              </div>
            </details>
          <% elsif !content_for?(:suppress_auth_buttons) %>
            <%= link_to "Sign in", new_session_path, class: "btn btn-secondary btn-sm" %>
            <%= link_to "Sign up", new_registration_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>

      </div>
    </header>
    <% end %>

    <main class="container<%= " container--tabbed" unless content_for?(:suppress_tabs) %>">
      <% flash.each do |type, message| %>
        <div class="flash <%= type %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>

    <% unless content_for?(:suppress_tabs) %>
      <%= render "shared/tab_bar" %>
    <% end %>
  </body>
</html>
