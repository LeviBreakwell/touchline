<% content_for :title, "Profile – Touchline" %>

<%# ── THE PROFILE: what you have done, not the controls for saying it ──
    The career page and this one were two screens showing the same person. They
    are one screen now: the account-scoped half — level, accolades, totals over
    every team — leads, and each roster's season detail follows it, because a
    Season belongs to a Team and cannot be aggregated.

    The slots are a form and live behind Customise. This screen is the one you
    hand somebody. %>
<%= render "shared/identity", user: @user, progression: @progression, name: @user.name %>
<%= render "shared/card_preview", user: @user, progression: @progression, line: @line %>

<div class="section-header">
  <h2 style="margin:0;">Showcase</h2>
  <%= link_to "Customise", profile_slots_path, class: "btn btn-secondary btn-sm" %>
</div>
<%= render "shared/showcase", progression: @progression %>

<%# ── EVERYTHING EARNED ── %>
<% if @progression.earned.any? %>
  <h2 class="profile-heading">Accolades <span class="count"><%= @progression.earned.size %></span></h2>
  <div class="accolade-list">
    <% @progression.earned.each do |accolade, count| %>
      <div class="accolade-row rarity-<%= accolade.rarity %>">
        <%= accolade_glyph(accolade) %>
        <div style="flex:1;min-width:0;">
          <div class="accolade-name"><%= accolade.title %><%= " ×#{count}" if count > 1 %></div>
          <div class="card-meta"><%= accolade.description %></div>
        </div>
        <div class="accolade-xp">+<%= accolade.xp * count %> XP</div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <p>No accolades yet.</p>
    <p class="card-meta">They come from playing — and from claiming a name that already has.</p>
  </div>
<% end %>

<%# ── EVERYTHING NOT EARNED ──
    Shown whether or not anything has been: a list of only what you have tells
    somebody with nothing that there is nothing to get. %>
<% if @progression.left_to_earn.positive? %>
  <h2 class="profile-heading">Still to earn <span class="count"><%= @progression.left_to_earn %></span></h2>
  <%= render "shared/aims", progression: @progression %>
<% end %>

<%# ── CAREER ──
    Every team at once, because a User is one person and every stat recorded
    against any of their names is theirs. %>
<h2 class="profile-heading">
  Career<% if @careers.many? %> <span class="count">all teams</span><% end %>
</h2>

<% if @players.empty? %>
  <div class="empty">
    <p>You're not linked to a player on any team yet.</p>
    <p class="card-meta">Open your team and tap your name on the roster to link up.</p>
  </div>
<% else %>
  <%= render "shared/career_totals", line: @line %>
  <%= render "shared/career_detail", line: @line, mvps: @progression.count_of("mvp") %>

  <%# ── A BLOCK PER ROSTER ──
      One heading each, so a season table is never ambiguous about whose season
      it is. With one team — which is nearly everybody — this reads as the rest
      of the page. %>
  <% @careers.each do |career| %>
    <h2 class="profile-heading">
      <%= link_to career.team.name, team_path(career.team) %>
      <span class="count"><%= pluralize(career.line.games, "game") %></span>
    </h2>

    <% if career.pending.any? %>
      <%= render "shared/pending_note", pending: career.pending %>
    <% end %>

    <% if career.any? %>
      <% if career.season %>
        <h3 class="profile-subheading">This season · <%= career.season.name %></h3>
        <%= render "shared/season_form", career: career, name: career.player.name %>
      <% end %>

      <h3 class="profile-subheading">By season</h3>
      <%= render "shared/season_table", career: career %>
    <% else %>
      <div class="empty">
        <p>No games recorded as <%= career.player.name %> yet.</p>
      </div>
    <% end %>
  <% end %>
<% end %>

<h2 class="profile-heading">Account</h2>
<div class="card">
  <div class="card-meta"><%= @user.email_address %> · Joined <%= @user.created_at.strftime("%B %Y") %></div>
</div>
