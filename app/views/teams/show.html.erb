<% content_for :title, "#{@team.name} – Touchline" %>

<%# ── THE TEAM TAB: the leaderboard, over whichever scope you pick ── %>
<div class="tab-head">
  <div class="tab-head-title">
    <% if nav_teams.many? %>
      <details class="team-switch">
        <summary><h1><%= @team.name %></h1><%= chevron_down %></summary>
        <div class="team-switch-menu">
          <% nav_teams.each do |team| %>
            <%= link_to team.name, team_path(team),
                  class: "nav-dropdown-link #{"is-current" if team == @team}" %>
          <% end %>
          <div class="nav-dropdown-divider"></div>
          <%= link_to "Connect another team", trl_locations_path, class: "nav-dropdown-link" %>
        </div>
      </details>
    <% else %>
      <h1><%= @team.name %></h1>
    <% end %>
    <p class="card-meta">
      <%= @team.location %><%= " · #{@team.division_name}" if @team.division_name.present? %>
    </p>
  </div>

  <div class="tab-head-actions">
    <% if @membership&.admin? %>
      <%= link_to team_settings_path(@team), class: "btn-gear", title: "Team settings",
                  aria: { label: "Team settings" } do %><%= gear_icon %><% end %>
    <% elsif @membership&.accepted? %>
      <span class="badge">Member</span>
    <% end %>
  </div>
</div>

<%# ── CLAIM PLAYER PROMPT ── %>
<% if @membership&.accepted? && @my_player.nil? && @unclaimed_players&.any? %>
  <div class="claim-prompt">
    <div class="claim-prompt-title">Which player on the roster is you?</div>
    <div class="claim-prompt-subtitle">Tap your name so your stats show up correctly.</div>
    <div class="claim-prompt-list">
      <% @unclaimed_players.each do |player| %>
        <%= button_to player.name, claim_team_player_path(@team, player), method: :patch, class: "claim-btn" %>
      <% end %>
    </div>
  </div>
<% end %>

<%# ── SCOPE ──
    A dropdown rather than chips: two seasons a year is seven chips after three
    years, wrapping across a phone. %>
<% if @leaderboard_seasons&.any? %>
  <div class="scope-row" data-controller="nav-select">
    <select class="scope-select" data-action="change->nav-select#go" aria-label="Leaderboard scope">
      <option value="<%= team_path(@team) %>" <%= "selected" if @leaderboard_season.nil? %>>All time</option>
      <% @leaderboard_seasons.each do |season| %>
        <option value="<%= team_path(@team, season_id: season.id) %>"
                <%= "selected" if @leaderboard_season == season %>><%= season.name %></option>
      <% end %>
    </select>
    <% if @team.seasons.any? && nav_season %>
      <%= link_to "Fixtures →", team_season_path(@team, nav_season), class: "scope-link" %>
    <% end %>
  </div>
<% end %>

<%# ── LEADERBOARD ── %>
<% if @membership&.accepted? || @leaderboard&.any? %>
  <% if @leaderboard&.any? %>
    <%= render "shared/leaderboard", rows: @leaderboard %>
  <% else %>
    <div class="empty" style="margin-bottom:1.25rem;">
      <p>No stats recorded for <%= @leaderboard_season&.name || "this team" %> yet.</p>
      <p class="card-meta">Only players who have taken the field are ranked.</p>
    </div>
  <% end %>
<% end %>

<%# ── SYNC STATE ── %>
<% if @team.seasons.none? %>
  <div class="card">
    <% if @team.fixtures_synced_at.nil? %>
      <p class="card-meta">Fixtures syncing…</p>
    <% else %>
      <p style="margin-bottom:0.5rem;">No fixtures found — the sync may have failed.</p>
      <p class="card-meta" style="margin-bottom:0.75rem;">Last attempted <%= time_ago_in_words(@team.fixtures_synced_at) %> ago.</p>
      <% if @membership&.admin? %>
        <%= button_to "Retry sync", sync_team_path(@team), method: :post, class: "btn btn-secondary btn-sm" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if Current.user %>
  <% if @membership.nil? %>
    <%= button_to "Request to join", team_join_path(@team), method: :post, class: "btn btn-secondary btn-full", style: "margin-top:1rem;" %>
  <% elsif @membership.pending? %>
    <div class="card" style="text-align:center;margin-top:1rem;">
      <p class="card-meta">Your join request is pending — an admin will approve you shortly.</p>
    </div>
  <% end %>
<% else %>
  <p style="text-align:center;margin-top:1.5rem;font-size:0.9rem;color:var(--gray-600);">
    <%= link_to "Sign in", new_session_path %> or <%= link_to "create an account", new_registration_path %> to join this team.
  </p>
<% end %>
