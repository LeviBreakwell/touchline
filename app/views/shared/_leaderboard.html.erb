<%# The Team's board: the same card the ladder is entered on, one scope up.
    rows: Leaderboard::Row %>
<div class="ladder ladder--board">
  <div class="ladder-head">
    <span class="sp-rank"></span>
    <span class="sp-avatar"></span>
    <span class="sp-who"></span>
    <span class="lcard-chips">
      <span class="h-g" title="Games">G</span>
      <span class="h-t" title="Tries">T</span>
      <span class="h-a" title="Assists">A</span>
      <span class="h-c" title="Bomb catches">C</span>
      <span class="h-e" title="Dropped bombs and critical errors">E</span>
    </span>
    <span class="sp-pts">PTS</span>
  </div>

  <% cosmetics = Progression.batch(rows.map { |row| row.player.user_id }) %>
  <% rows.each_with_index do |row, index| %>
    <%= render "shared/stat_card", row: row, rank: index + 1, mvp: false, cosmetics: cosmetics %>
  <% end %>
</div>
