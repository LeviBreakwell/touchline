<% content_for :title, "Touchline" %>

<% if Current.user %>
  <div class="section-header" style="margin-bottom:1.25rem;">
    <h1>My Teams</h1>
    <%= link_to "Find on TRL", trl_locations_path, class: "btn btn-secondary btn-sm" %>
  </div>

  <% if @my_teams.empty? %>
    <div class="empty">
      <p>You're not part of any team yet.</p>
      <%= link_to "Find your team on TRL", trl_locations_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <% @my_teams.each do |team| %>
      <% season = team.seasons.max_by(&:created_at) %>
      <% next_to_record = season && @next_to_record_by_season[season.id] %>

      <% if next_to_record %>
        <%= link_to team_season_fixture_path(team, season, next_to_record), class: "record-prompt", style: "margin-bottom:0.75rem;" do %>
          <div class="record-prompt-eyebrow"><%= team.name %> · <%= season.name %></div>
          <div class="record-prompt-title">vs <%= next_to_record.opponent_name %></div>
          <div class="record-prompt-meta">
            <%= next_to_record.date&.strftime("%a %-d %b") %>
            &middot;
            <%= next_to_record.our_score %> – <%= next_to_record.opponent_score %>
            <span class="badge badge-<%= next_to_record.result %>" style="margin-left:0.25rem;"><%= next_to_record.result.upcase %></span>
          </div>
          <div class="record-prompt-cta">Enter tries &amp; assists →</div>
        <% end %>
      <% else %>
        <% path = season ? team_season_path(team, season) : team_path(team) %>
        <%= link_to path, class: "card", style: "display:block;text-decoration:none;color:inherit;margin-bottom:0.75rem;" do %>
          <div class="card-title"><%= team.name %></div>
          <div class="card-meta"><%= team.location %> &middot; <%= season&.name || "No season yet" %></div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <% content_for :suppress_header, true %>
  <div class="landing">

    <div class="landing-hero">
      <div class="landing-eyebrow">Touchline</div>
      <h1 class="landing-headline">Track your TRL career.</h1>
      <p class="landing-sub">Every game, every try, every assist — season after season. Fixtures pulled straight from TRL Australia.</p>
      <div class="landing-cta">
        <%= link_to "Sign up free", new_registration_path, class: "btn btn-primary btn-landing" %>
        <span class="landing-cta-or">Already on a team?</span>
        <%= link_to "Sign in", new_session_path, class: "landing-signin-link" %>
      </div>
    </div>


    <div class="landing-shots">
      <figure class="landing-shot">
        <div class="phone">
          <%= image_tag "screen-leaderboard.jpg", width: 500, height: 707,
                alt: "The Touchline season leaderboard, ranking ten players by points with games, tries and assists alongside." %>
        </div>
        <figcaption>
          <strong>Season leaderboard</strong>
          Every player ranked by points. Filter by season or go all time.
        </figcaption>
      </figure>

      <figure class="landing-shot">
        <div class="phone">
          <%= image_tag "screen-entry.jpg", width: 500, height: 707, loading: "lazy",
                alt: "Recording stats after a game: each player has a tick for whether they played and plus and minus buttons for tries and assists." %>
        </div>
        <figcaption>
          <strong>Two-minute stat entry</strong>
          Tick who played, tap in tries and assists. Totals update as you go.
        </figcaption>
      </figure>

      <figure class="landing-shot">
        <div class="phone">
          <%= image_tag "screen-career.jpg", width: 500, height: 707, loading: "lazy",
                alt: "A player's career page showing points, tries, assists, games, seasons and points per game." %>
        </div>
        <figcaption>
          <strong>Your career</strong>
          Totals and averages across every season you've played.
        </figcaption>
      </figure>
    </div>

    <div class="landing-features">
      <div class="landing-feature">
        <div>
          <div class="landing-feature-title">Fixtures from TRL, automatically</div>
          <div class="landing-feature-body">Connect your team to Spawtz once. Fixtures and results pull through every day.</div>
        </div>
      </div>
      <div class="landing-feature">
        <div>
          <div class="landing-feature-title">Enter stats after the final whistle</div>
          <div class="landing-feature-body">Any team member taps in who played, plus tries and assists, on their phone. Takes two minutes.</div>
        </div>
      </div>
      <div class="landing-feature">
        <div>
          <div class="landing-feature-title">Season leaderboard</div>
          <div class="landing-feature-body">Points tally updates after every game. Filter by season or go all-time, and settle the pub debate once and for all.</div>
        </div>
      </div>
      <div class="landing-feature">
        <div>
          <div class="landing-feature-title">Career stats</div>
          <div class="landing-feature-body">Games played, tries, assists and points across every season you've turned out. Averages per game and per season, on your own profile.</div>
        </div>
      </div>
    </div>

    <div class="landing-footer-note">Free. No ads. No nonsense.</div>

  </div>
<% end %>
