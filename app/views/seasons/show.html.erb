<% content_for :title, "#{@season.name} – #{@team.name}" %>

<%# ── THE SEASON TAB: that season's matches ──
    The leaderboard is the Team tab's job, over any scope you like. This tab is
    the draw. %>
<div class="tab-head">
  <div class="tab-head-title">
    <h1><%= @season.name %></h1>
    <p class="card-meta"><%= @team.name %></p>
  </div>
</div>

<% if @seasons.many? %>
  <div class="scope-row" data-controller="nav-select">
    <select class="scope-select" data-action="change->nav-select#go" aria-label="Season">
      <% @seasons.each do |season| %>
        <option value="<%= team_season_path(@team, season) %>"
                <%= "selected" if season == @season %>><%= season.name %></option>
      <% end %>
    </select>
  </div>
<% end %>

<%= render "seasons/tabs", team: @team, season: @season, active: :fixtures %>

<%# ── ENTER STATS PROMPT (most recently played game with no stats yet) ── %>
<% if @next_to_record && Current.user&.member_of?(@team) %>
  <%= link_to team_season_fixture_path(@team, @season, @next_to_record), class: "record-prompt" do %>
    <div class="record-prompt-eyebrow">Stats not entered yet</div>
    <div class="record-prompt-title">vs <%= @next_to_record.opponent_name %></div>
    <div class="record-prompt-meta">
      <%= @next_to_record.date&.strftime("%a %-d %b") %>
      &middot;
      <% if @next_to_record.played? %>
        <%= @next_to_record.our_score %> – <%= @next_to_record.opponent_score %>
        <span class="badge badge-<%= @next_to_record.result %>" style="margin-left:0.25rem;"><%= @next_to_record.result.upcase %></span>
      <% end %>
    </div>
    <div class="record-prompt-cta">Enter stats →</div>
  <% end %>
<% end %>

<%# ── FIXTURES ── %>
<h2 style="margin-bottom:0.75rem;">Fixtures</h2>
<% if @fixtures.empty? %>
  <div class="empty"><p>No fixtures yet.</p></div>
<% else %>
  <% @fixtures.each do |fixture| %>
    <%= link_to team_season_fixture_path(@team, @season, fixture), class: "card fixture-card" do %>
      <div class="fixture-vs">
        <div class="opponent">vs <%= fixture.opponent_name %></div>
        <div class="date"><%= fixture.date&.strftime("%a %-d %b · %-I:%M%P") %></div>
      </div>
      <div class="fixture-status">
        <% if fixture.final? %><span class="badge badge-finals"><%= fixture.finals_label %></span><% end %>
        <% if fixture.played? %>
          <div class="fixture-score"><%= fixture.our_score %> – <%= fixture.opponent_score %></div>
          <span class="badge badge-<%= fixture.result %>"><%= fixture.result.upcase %></span>
        <% else %>
          <span class="badge badge-tbd">TBD</span>
        <% end %>
        <% unless fixture.stats_status == :verified %><%= trl_status_badge(fixture) %><% end %>
      </div>
      <% scorers = fixture_scorers(fixture, @players_by_id) %>
      <% if scorers.any? %>
        <div class="fixture-scorers">
          <% scorers.each do |scorer| %>
            <span class="scorer">
              <span class="scorer-name"><%= scorer.player.name %></span>
              <%= stat_tally(scorer.tries, :tries) %>
              <%= stat_tally(scorer.assists, :assists) %>
            </span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @fixtures.none?(&:stats_entered?) && @next_to_record.nil? %>
  <div class="empty" style="margin-top:1rem;">
    <p>No stats yet. Tap a played fixture to enter them.</p>
  </div>
<% end %>
