<div id="<%= dom_id fixture %>">
  <p>
    <strong>Opponent name:</strong>
    <%= fixture.opponent_name %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= fixture.date %>
  </p>

  <p>
    <strong>Is played:</strong>
    <%= fixture.is_played %>
  </p>

  <p>
    <strong>Team:</strong>
    <%= fixture.team_id %>
  </p>

</div>
