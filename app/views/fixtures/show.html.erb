<% content_for :title, "vs #{@fixture.opponent_name} – #{@team.name}" %>
<%# The ladder takes over the screen. A 56px bar sits exactly where a drag
    toward the last card ends, and there is nowhere else to put it. %>
<% content_for :suppress_tabs, true %>

<%= back_button @season.name, team_season_path(@team, @season) %>

<div class="section-header" style="margin-bottom:1rem;">
  <div>
    <h1>vs <%= @fixture.opponent_name %></h1>
    <p class="card-meta">
      <% if @fixture.final? %><strong><%= @fixture.finals_label %></strong> · <% end %>
      <%= @fixture.date&.strftime("%A %-d %B %Y") %>
    </p>
  </div>
  <div style="text-align:right;">
    <% if @fixture.played? %>
      <div style="font-size:1.5rem;font-weight:700;line-height:1.1;"><%= @fixture.our_score %> – <%= @fixture.opponent_score %></div>
      <span class="badge badge-<%= @fixture.result %>"><%= @fixture.result.upcase %></span>
    <% else %>
      <span class="badge badge-tbd">Upcoming</span>
    <% end %>
    <%= trl_status_badge(@fixture) %>
  </div>
</div>

<% if @team.players.none? %>
  <div class="empty">
    <p>No players on roster.</p>
    <% if Current.user&.admin_of?(@team) %>
      <%= link_to "Add players", team_settings_path(@team), class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
<% elsif @editable %>
  <div data-controller="match-ladder dialog ladder-tour"
       data-match-ladder-hold-value="400"
       data-match-ladder-locked-value="<%= @fixture.locked? %>"
       data-match-ladder-urls-value="<%= {
         touchdowns:  team_season_fixture_touchdowns_path(@team, @season, @fixture),
         plays:       team_season_fixture_plays_path(@team, @season, @fixture),
         appearances: team_season_fixture_appearances_path(@team, @season, @fixture),
         latestTouchdown: team_season_fixture_latest_touchdown_path(@team, @season, @fixture),
         latestPlay:      team_season_fixture_latest_play_path(@team, @season, @fixture),
         lock:            team_season_fixture_lock_path(@team, @season, @fixture)
       }.to_json %>"
       class="<%= "is-locked" if @fixture.locked? %>">

    <div class="ladder-hint">
      <p data-match-ladder-target="hint"><%= @fixture.locked? ? "Locked — scroll anywhere safely. Tap Unlock to enter stats again." : "Tap a card for a try · drag one onto another for the assist · hold for everything else. To scroll, use the strip on the left edge." %></p>
      <div class="ladder-hint-actions">
        <button type="button" class="btn-icon" data-action="ladder-tour#open"
                title="How this screen works" aria-label="How this screen works">?</button>
        <button type="button" class="btn btn-secondary btn-sm" data-match-ladder-target="lock"
                data-action="match-ladder#toggleLock"><%= @fixture.locked? ? "Unlock" : "Lock" %></button>
        <button type="button" class="btn btn-secondary btn-sm" data-match-ladder-target="undo"
                data-action="match-ladder#undo" hidden>Undo</button>
      </div>
    </div>

    <div data-match-ladder-target="board">
      <%= render "fixtures/ladder", ladder: @ladder, editable: true %>
    </div>

    <svg class="drag-layer" data-match-ladder-target="dragLayer"></svg>
    <div class="drag-chip" data-match-ladder-target="dragChip"></div>
    <div class="ladder-toast" data-match-ladder-target="toast" role="status" aria-live="polite"></div>

    <%# ── FIRST-VISIT TOUR ──
        Shown once per browser (see ladder_tour_controller), and reopenable any
        time from the "?" button above. Composes with the generic dialog
        controller for backdrop/close so this one only has to decide *when* to
        open and remember that it has. %>
    <dialog class="modal" data-dialog-target="dialog" data-ladder-tour-target="dialog"
            data-action="click->dialog#closeOnBackdrop close->ladder-tour#dismiss">
      <div class="modal-panel">
        <div class="modal-head">
          <h2>Entering stats</h2>
          <button type="button" class="modal-close" data-action="dialog#close" aria-label="Close">&times;</button>
        </div>
        <%# Each row's trailing text is one flex item, not bare children — a
            flex container turns every child (including a nested <strong> and
            the text around it) into its own box, which splits a sentence
            with inline markup into misaligned columns. %>
        <ul class="tour-list">
          <li><span class="tour-mark try">tap</span> <span>a card on its own for a try.</span></li>
          <li><span class="tour-mark assist">drag</span> <span>one card onto another — a try for who you drop on, an assist for who you dragged.</span></li>
          <li><span class="tour-mark hold">hold</span> <span>a card for bomb catches, dropped bombs, critical errors, or to undo something on it.</span></li>
          <li><span class="tour-mark scroll">scroll</span> <span>from the narrow strip on the left edge — the rest of every card is a tap/drag target. Tap <strong>Lock</strong> above the ladder to freeze entry while you scroll instead.</span></li>
        </ul>
        <button type="button" class="btn btn-primary btn-full" data-action="dialog#close">Got it</button>
      </div>
    </dialog>
  </div>
<% else %>
  <%= render "fixtures/ladder", ladder: @ladder, editable: false %>

  <p style="text-align:center;font-size:0.85rem;color:var(--gray-400);margin-top:0.75rem;">
    <% if Current.user %>
      Join the team to enter stats.
    <% else %>
      <%= link_to "Sign in", new_session_path %> to enter stats.
    <% end %>
  </p>
<% end %>
