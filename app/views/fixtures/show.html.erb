<% content_for :title, "vs #{@fixture.opponent_name} – #{@team.name}" %>

<div style="margin-bottom:0.5rem;">
  <%= link_to "← #{@season.name}", team_season_path(@team, @season), style: "font-size:0.9rem;color:var(--gray-600);text-decoration:none;" %>
</div>

<div class="section-header" style="margin-bottom:1rem;">
  <div>
    <h1>vs <%= @fixture.opponent_name %></h1>
    <p class="card-meta"><%= @fixture.date&.strftime("%A %-d %B %Y") %></p>
  </div>
  <% if @fixture.played? %>
    <div style="text-align:right;">
      <div style="font-size:1.5rem;font-weight:700;line-height:1.1;"><%= @fixture.our_score %> – <%= @fixture.opponent_score %></div>
      <span class="badge badge-<%= @fixture.result %>"><%= @fixture.result.upcase %></span>
    </div>
  <% else %>
    <span class="badge badge-tbd">Upcoming</span>
  <% end %>
</div>

<% if @players.empty? %>
  <div class="empty">
    <p>No players on roster.</p>
    <% if Current.user&.admin_of?(@team) %>
      <%= link_to "Add players", team_players_path(@team), class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
<% else %>
  <% if @is_member %>
    <%= form_with url: bulk_team_season_fixture_game_stats_path(@team, @season, @fixture),
                  method: :post,
                  data: { controller: "stat-total" } do |f| %>

      <div class="stat-total-bar">
        <span style="font-size:0.8rem;color:var(--gray-400);">Team total</span>
        <span class="stat-total-value" data-stat-total-target="total">
          <%
            total_tries   = @game_stats.values.sum(&:tries)
            total_assists = @game_stats.values.sum(&:assists)
            total_points  = (total_tries * 2) + total_assists
          %>
          <%= total_tries %>T · <%= total_assists %>A · <%= total_points %> pts
        </span>
      </div>

      <div class="card" style="padding:0.5rem 1rem;margin-bottom:0.75rem;">
        <% @players.each_with_index do |player, i| %>
          <% stat = @game_stats[player.id] %>
          <div class="stat-row">
            <div class="stat-player-info">
              <div class="stat-player-name"><%= player.name %></div>
              <div class="stat-player-pts" data-pts><%= stat ? (stat.tries * 2 + stat.assists) : 0 %> pts</div>
            </div>

            <input type="hidden" name="game_stats[<%= i %>][player_id]" value="<%= player.id %>">
            <div class="stat-steppers">
              <div class="stepper-group">
                <div class="stepper-label">T</div>
                <div class="stepper">
                  <button type="button" class="stepper-btn" data-action="click->stat-total#dec" data-field="tries">−</button>
                  <span class="stepper-val" data-display="tries"><%= stat&.tries || 0 %></span>
                  <button type="button" class="stepper-btn" data-action="click->stat-total#inc" data-field="tries">+</button>
                </div>
                <input type="number" name="game_stats[<%= i %>][tries]" value="<%= stat&.tries || 0 %>"
                       min="0" max="99" style="display:none" data-field="tries">
              </div>
              <div class="stepper-group">
                <div class="stepper-label">A</div>
                <div class="stepper">
                  <button type="button" class="stepper-btn" data-action="click->stat-total#dec" data-field="assists">−</button>
                  <span class="stepper-val" data-display="assists"><%= stat&.assists || 0 %></span>
                  <button type="button" class="stepper-btn" data-action="click->stat-total#inc" data-field="assists">+</button>
                </div>
                <input type="number" name="game_stats[<%= i %>][assists]" value="<%= stat&.assists || 0 %>"
                       min="0" max="99" style="display:none" data-field="assists">
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <button type="submit" class="btn btn-secondary btn-full"
              data-stat-total-target="saveBtn">Save stats</button>
    <% end %>

  <% else %>
    <div data-controller="stat-total">
      <div class="card" style="padding:0.5rem 1rem;">
        <% @players.each do |player| %>
          <% stat = @game_stats[player.id] %>
          <div class="stat-row">
            <div class="stat-player-info">
              <div class="stat-player-name"><%= player.name %></div>
            </div>
            <div class="stat-readonly">
              <div class="stat-readonly-item"><span class="stepper-label">T</span> <strong><%= stat&.tries || 0 %></strong></div>
              <div class="stat-readonly-item"><span class="stepper-label">A</span> <strong><%= stat&.assists || 0 %></strong></div>
              <div class="stat-readonly-pts"><%= stat ? (stat.tries * 2 + stat.assists) : 0 %> pts</div>
            </div>
          </div>
        <% end %>
      </div>

      <% if Current.user %>
        <p style="text-align:center;font-size:0.85rem;color:var(--gray-400);margin-top:0.5rem;">Join the team to enter stats.</p>
      <% else %>
        <p style="text-align:center;font-size:0.85rem;color:var(--gray-400);margin-top:0.5rem;">
          <%= link_to "Sign in", new_session_path %> to enter stats.
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>
