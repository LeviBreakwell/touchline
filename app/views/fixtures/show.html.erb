<% content_for :title, "vs #{@fixture.opponent_name} – #{@team.name}" %>
<%# The ladder takes over the screen. A 56px bar sits exactly where a drag
    toward the last card ends, and there is nowhere else to put it. %>
<% content_for :suppress_tabs, true %>

<%= back_button @season.name, team_season_path(@team, @season) %>

<div class="section-header" style="margin-bottom:1rem;">
  <div>
    <h1>vs <%= @fixture.opponent_name %></h1>
    <p class="card-meta">
      <% if @fixture.final? %><strong><%= @fixture.finals_label %></strong> · <% end %>
      <%= @fixture.date&.strftime("%A %-d %B %Y") %>
    </p>
  </div>
  <div style="text-align:right;">
    <% if @fixture.played? %>
      <div style="font-size:1.5rem;font-weight:700;line-height:1.1;"><%= @fixture.our_score %> – <%= @fixture.opponent_score %></div>
      <span class="badge badge-<%= @fixture.result %>"><%= @fixture.result.upcase %></span>
    <% else %>
      <span class="badge badge-tbd">Upcoming</span>
    <% end %>
    <%= trl_status_badge(@fixture) %>
  </div>
</div>

<% if @team.players.none? %>
  <div class="empty">
    <p>No players on roster.</p>
    <% if Current.user&.admin_of?(@team) %>
      <%= link_to "Add players", team_settings_path(@team), class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
<% elsif @editable %>
  <div data-controller="match-ladder"
       data-match-ladder-hold-value="400"
       data-match-ladder-urls-value="<%= {
         touchdowns:  team_season_fixture_touchdowns_path(@team, @season, @fixture),
         plays:       team_season_fixture_plays_path(@team, @season, @fixture),
         appearances: team_season_fixture_appearances_path(@team, @season, @fixture)
       }.to_json %>">

    <div class="ladder-hint">
      <p>Tap a card for a try · drag one card onto another for the assist · hold for everything else.</p>
      <button type="button" class="btn btn-secondary btn-sm" data-match-ladder-target="undo"
              data-action="match-ladder#undo" hidden>Undo</button>
    </div>

    <div data-match-ladder-target="board">
      <%= render "fixtures/ladder", ladder: @ladder, editable: true %>
    </div>

    <svg class="drag-layer" data-match-ladder-target="dragLayer"></svg>
    <div class="drag-chip" data-match-ladder-target="dragChip"></div>
    <div class="ladder-toast" data-match-ladder-target="toast" role="status" aria-live="polite"></div>
  </div>
<% else %>
  <%= render "fixtures/ladder", ladder: @ladder, editable: false %>

  <p style="text-align:center;font-size:0.85rem;color:var(--gray-400);margin-top:0.75rem;">
    <% if Current.user %>
      Join the team to enter stats.
    <% else %>
      <%= link_to "Sign in", new_session_path %> to enter stats.
    <% end %>
  </p>
<% end %>
